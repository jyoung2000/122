# ClipAI Environment Configuration
# Copy this file to .env and fill in your values.

# ── AI Provider Keys (at least one required for analysis) ──
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── ClipAI API Key ──
# If not set, a key is auto-generated on first boot.
# Retrieve it from Settings > API Access or the container logs.
CLIPAI_API_KEY=

# ── Webhook Settings ──
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

# ── GPU Hardware Acceleration ──
# Toggle also available in Settings > Advanced.
# GPU_ACCELERATION_ENABLED=false
# GPU_VENDOR_OVERRIDE=           # auto | nvidia | intel | amd

# ── Ollama (optional, for local models) ──
OLLAMA_HOST=http://host.docker.internal:11434
